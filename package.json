{
  "name": "facevault-hollaex-plugin",
  "version": "2.0.14",
  "description": "FaceVault KYC plugin for HollaEx exchanges (Cloud-compatible hosted-page mode)",
  "private": true,
  "scripts": {
    "build": "node build.js",
    "build:minify": "node build.js --minify",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.jsx?$": [
        "babel-jest",
        { "presets": ["@babel/preset-env", "@babel/preset-react"] }
      ]
    },
    "collectCoverageFrom": [
      "web/views/utils.js"
    ],
    "coverageThreshold": {
      "./web/views/utils.js": {
        "branches": 80,
        "functions": 100,
        "lines": 90,
        "statements": 90
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kaditham-technologies/facevault-hollaex"
  },
  "bugs": {
    "url": "https://github.com/kaditham-technologies/facevault-hollaex/issues"
  },
  "homepage": "https://facevault.id/integrations",
  "author": "FaceVault <support@facevault.id>",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^14.3.1",
    "babel-jest": "^30.0.0",
    "babel-loader": "^10.1.1",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "webpack": "^5.105.4",
    "webpack-cli": "^7.0.2"
  }
}
